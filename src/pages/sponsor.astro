---
import { Icon } from "astro-icon/components";
import { siteConfig } from "@/config";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

// 打赏功能已关闭，本页仅作为 GitHub 跳转过渡页
const GITHUB_URL = "https://github.com/shangq729-a11y/Firefly";

if (!siteConfig.pages.sponsor) {
	return Astro.redirect("/404/");
}
---

<MainGridLayout title="前往 GitHub" description="正在跳转到 GitHub 仓库…">
  <div class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32">
    <div class="card-base z-10 px-9 py-10 relative w-full flex flex-col items-center text-center">
      <div class="h-12 w-12 rounded-lg bg-(--primary) flex items-center justify-center text-white dark:text-black/70 mb-4">
        <Icon is:inline name="fa7-brands:github" class="text-[1.75rem]" />
      </div>
      <div class="text-2xl font-bold text-neutral-900 dark:text-neutral-100 mb-2">
        打赏功能已关闭
      </div>
      <p class="text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed mb-6 max-w-md">
        感谢你的支持！本站不再接受打赏，正在为你跳转到 GitHub 仓库，欢迎来看看或提建议喵~
      </p>
      <a
        href={GITHUB_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-6 py-2.5 bg-(--primary) text-white dark:text-black/70 rounded-lg font-medium hover:bg-(--primary)/90 active:scale-95 transition-all"
      >
        <span>立即前往 GitHub</span>
        <Icon is:inline name="fa7-solid:arrow-up-right-from-square" class="text-sm" />
      </a>
      <p class="text-xs text-neutral-400 dark:text-neutral-500 mt-4">
        {GITHUB_URL}
      </p>
    </div>
  </div>
</MainGridLayout>

<script is:inline>
  // 3 秒后自动跳转（手动点击也可立即前往）
  setTimeout(function () {
    window.location.replace("https://github.com/shangq729-a11y/Firefly");
  }, 3000);
</script>

